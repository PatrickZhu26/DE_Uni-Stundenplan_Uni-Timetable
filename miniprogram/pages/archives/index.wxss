.page{padding:30rpx;max-width:1200px;margin:auto}.title{font-size:38rpx;font-weight:800;margin:20rpx 0}.hint{color:#7c8b9f;font-size:24rpx;line-height:1.6}.primary{background:#216cbd;color:#fff;margin:28rpx 0;border-radius:16rpx}.record{background:#fff;padding:28rpx;border-radius:18rpx;margin:18rpx 0}.record-title{font-weight:700;color:#203b60;font-size:29rpx}.empty{padding:70rpx 15rpx;text-align:center;color:#8a97a8}.row,.week{display:flex;gap:16rpx;align-items:center}.row button{flex:1;background:#eaf1fa;color:#216cbd;font-size:23rpx}.back{margin:0;background:#eaf1fa;color:#216cbd;font-size:24rpx}.week{margin:24rpx 0;font-size:23rpx}.week text{flex:1;text-align:center}.week button{width:70rpx!important;margin:0;background:#eaf1fa;color:#216cbd}.grid-head,.grid-body{display:flex;background:#fff}.grid-head{background:#eaf3fc;min-height:70px}.time-head,.time-axis{width:62px;flex-shrink:0;position:relative;font-size:12px}.time-head{padding:15px 4px;box-sizing:border-box}.day-head{box-sizing:border-box;text-align:center;flex-shrink:0;font-weight:700;padding:12px 4px;border-left:1px solid #d5dee9;font-size:15px}.day-head view{font-weight:400;font-size:12px;margin-top:4px}.holiday{color:#b76e18}.hour{position:absolute;left:4px;font-size:12px;color:#6b7b90}.column{position:relative;flex-shrink:0;border-left:1px solid #d5dee9;box-sizing:border-box;background:repeating-linear-gradient(to bottom,transparent 0,transparent 99px,#e6edf5 99px,#e6edf5 100px)}.block{position:absolute;box-sizing:border-box;background:#eef5fc;border:1px solid #aac0d8;border-left:4px solid;padding:7px;font-size:12px;line-height:1.5}.block-content{height:100%}.bold{font-weight:700;font-size:14px}button{width:auto!important}
.record-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:6px}.record-delete{margin:0;flex-shrink:0;background:#fff0ec;color:#b35b4b;font-size:12px;padding:0 12px;line-height:32px}.clear-archives{font-size:12px;background:transparent;color:#ad7065;margin:18px 0}.compact-block{border-radius:5px}.number-block{padding:0;border-left-width:2px;background:#dbeafd}.archive-number{height:100%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px}.archive-reminder{font-size:10px;line-height:1.4;background:#fff0d8;color:#a87028;margin-top:5px;padding:3px 4px;border-radius:4px}
@media(min-width:600px){.page{padding:24px 28px 60px}.title{font-size:28px;margin:20px 0}.hint{font-size:14px}.record{padding:24px;border-radius:16px;margin:16px 0}.record-title{font-size:18px}.primary{font-size:15px;margin:22px 0;line-height:46px}.row button,.week,.back{font-size:14px}.week{margin:22px 0}.week button{width:40px!important;line-height:40px}.empty{padding:40px 15px}}
@media(max-width:359px){.page{padding-left:12px;padding-right:12px}.record{padding:17px}.record-title{font-size:15px}.record-bottom .hint{font-size:11px}.week{gap:6px}.week text{font-size:11px}}
.compact-grid .time-head,.compact-grid .time-axis{width:44px;min-width:44px}.compact-grid .hour{font-size:10px;left:2px}.compact-grid .day-head{font-size:13px;padding:10px 2px}.compact-grid .day-head view{font-size:10px}.compact-block{padding:7px 4px}.compact-block .bold{font-size:12px;word-break:break-word}.number-block{padding:0}
.archive-scroll{width:100%;box-sizing:border-box;overflow:hidden}
.tablet-layout .week{width:100%;box-sizing:border-box;gap:16px;padding:12px;background:#fff;border-radius:14px}
.tablet-layout .day-head{overflow-wrap:anywhere}
.tablet-layout .block{word-break:break-word;font-size:11px}
.tablet-layout .bold{font-size:13px}

/* Explicitly anchor the action: native mini-button auto margins vary by client. */
.record{box-sizing:border-box;width:100%}
.record-heading{display:flex;align-items:flex-start;gap:12px;width:100%;box-sizing:border-box}
.record-title{flex:1;min-width:0;overflow-wrap:anywhere;word-break:break-word}
.record-chevron{flex:0 0 auto;line-height:1.5;color:#203b60}
.record-bottom{width:100%;box-sizing:border-box;gap:12px}
.record-info{flex:1;min-width:0;overflow-wrap:anywhere;word-break:break-word}
.record-bottom .record-delete{flex:0 0 auto;align-self:center;margin:0 0 0 auto!important;width:auto!important;min-width:60px;min-height:40px;box-sizing:border-box;padding:10px 14px;line-height:20px;border-radius:10px;font-size:13px;white-space:nowrap}
.page{padding-left:calc(30rpx + var(--safe-left, 0px));padding-right:calc(30rpx + var(--safe-right, 0px))}
@media(min-width:600px){.page{padding-left:calc(28px + var(--safe-left, 0px));padding-right:calc(28px + var(--safe-right, 0px))}}
@media(max-width:359px){.page{padding-left:calc(12px + var(--safe-left, 0px));padding-right:calc(12px + var(--safe-right, 0px))}}
