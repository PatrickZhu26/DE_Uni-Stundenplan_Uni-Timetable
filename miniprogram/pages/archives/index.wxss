.page{padding:30rpx;max-width:1200px;margin:auto}.title{font-size:38rpx;font-weight:800;margin:20rpx 0}.hint{color:#7c8b9f;font-size:24rpx;line-height:1.6}.primary{background:#216cbd;color:#fff;margin:28rpx 0;border-radius:16rpx}.record{background:#fff;padding:28rpx;border-radius:18rpx;margin:18rpx 0}.record-title{font-weight:700;color:#203b60;font-size:29rpx}.record-title text{float:right}.empty{padding:70rpx 15rpx;text-align:center;color:#8a97a8}.row,.week{display:flex;gap:16rpx;align-items:center}.row button{flex:1;background:#eaf1fa;color:#216cbd;font-size:23rpx}.back{margin:0;background:#eaf1fa;color:#216cbd;font-size:24rpx}.week{margin:24rpx 0;font-size:23rpx}.week text{flex:1;text-align:center}.week button{width:70rpx!important;margin:0;background:#eaf1fa;color:#216cbd}.grid-head,.grid-body{display:flex;background:#fff}.grid-head{background:#eaf3fc;min-height:70px}.time-head,.time-axis{width:62px;flex-shrink:0;position:relative;font-size:12px}.time-head{padding:15px 4px;box-sizing:border-box}.day-head{box-sizing:border-box;text-align:center;flex-shrink:0;font-weight:700;padding:12px 4px;border-left:1px solid #d5dee9;font-size:15px}.day-head view{font-weight:400;font-size:12px;margin-top:4px}.holiday{color:#b76e18}.hour{position:absolute;left:4px;font-size:12px;color:#6b7b90}.column{position:relative;flex-shrink:0;border-left:1px solid #d5dee9;box-sizing:border-box;background:repeating-linear-gradient(to bottom,transparent 0,transparent 99px,#e6edf5 99px,#e6edf5 100px)}.block{position:absolute;box-sizing:border-box;background:#eef5fc;border:1px solid #aac0d8;border-left:4px solid;padding:7px;font-size:12px;line-height:1.5}.block-content{height:100%}.bold{font-weight:700;font-size:14px}button{width:auto!important}
