<view class="page">
 <view wx:if="{{!selected}}"><view class="title">学期课表档案</view><view class="hint">保存课程、批注及当时的显示和假期设置。查看往期不会覆盖当前课表。</view><button class="primary" bindtap="saveCurrent">＋ 保存当前学期课表</button><view wx:for="{{records}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="open"><view class="record-title">{{item.title}}<text> ›</text></view><view class="hint">{{item.count}} 个课时 · 保存于 {{item.savedAt}}</view></view><view wx:if="{{!records.length}}" class="empty">保存后，可以在这里查看往期学期。</view><view class="row"><button bindtap="backup">复制档案备份</button><button bindtap="restore">导入档案备份</button></view></view>
 <view wx:else><button class="back" bindtap="close">‹ 返回学期档案</button><view class="title">{{selected.title}}</view><view class="hint">往期只读课表 · {{selected.count}} 个课时</view><view class="week"><button data-delta="-1" bindtap="week">‹</button><text>{{weekLabel}}</text><button data-delta="1" bindtap="week">›</button></view><scroll-view scroll-x><view style="width:{{width}}px;"><view class="grid-head"><view class="time-head">时间</view><view wx:for="{{days}}" wx:key="day" style="width:{{item.width}}px;" class="day-head">{{item.name}}<view>{{item.date}}</view><view class="holiday">{{item.holiday.cn}} {{item.holiday.de}} {{item.holiday.custom}}</view></view></view><view class="grid-body" style="height:{{height}}px;"><view class="time-axis"><view wx:for="{{hours}}" wx:key="label" class="hour" style="top:{{item.top}}px;">{{item.label}}</view></view><view wx:for="{{days}}" wx:for-item="day" wx:key="day" class="column" style="width:{{day.width}}px;"><view wx:for="{{day.blocks}}" wx:for-item="course" wx:key="id" class="block" style="top:{{course.top}}px;height:{{course.height}}px;left:{{course.leftPct}}%;width:{{course.widthPct}}%;border-left-color:{{course.courseColor}};"><scroll-view scroll-y class="block-content"><view class="bold">📖 {{course.title}}</view><view>{{course.type}} · {{course.start}}–{{course.end}}</view><view>每周 {{course.from}} 至 {{course.to}}</view><view>📍 {{course.room}} · {{course.building}}</view><view wx:if="{{course.teacher}}">👤 {{course.teacher}}</view><view wx:if="{{course.note}}">📝 {{course.note}}</view></scroll-view></view></view></view></view></scroll-view></view>
</view>
