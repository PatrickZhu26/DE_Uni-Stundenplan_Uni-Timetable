<view class="page {{fitGrid?'tablet-layout':''}}" style="{{safeAreaStyle}}">
 <view wx:if="{{!selected}}"><view class="title">学期课表档案</view><view class="hint">导入课表后自动保存；关联学期会随课程、取消日期、考试与作业修改一起更新。查看往期不改变当前课表。</view><button class="primary" bindtap="saveCurrent">＋ 保存当前学期课表</button><view wx:for="{{records}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="open"><view class="record-heading"><view class="record-title">{{item.title}}</view><text class="record-chevron">›</text></view><view class="record-bottom"><view class="hint record-info">{{item.count}} 个课时 · 保存于 {{item.savedAt}}<view wx:if="{{!item.count}}">空白课表 · 已同步清空</view></view><button size="mini" class="record-delete" data-id="{{item.id}}" catchtap="remove">删除</button></view></view><button wx:if="{{records.length}}" class="clear-archives" bindtap="clearAll">删除所有学期档案</button><view wx:if="{{!records.length}}" class="empty">保存后，可以在这里查看往期学期。</view><view class="row"><button bindtap="backup">复制档案备份</button><button bindtap="restore">导入档案备份</button></view></view>
 <view wx:else><button class="back" bindtap="close">‹ 返回学期档案</button><view class="title">{{selected.title}}</view><view class="hint">学期课表 · 只读查看 · {{selected.count}} 个课时</view><view wx:if="{{!selected.count}}" class="empty">此学期课表已同步为空白，仍可删除或导出档案。</view><view class="week"><button data-delta="-1" bindtap="week">‹</button><text>{{weekLabel}}</text><button data-delta="1" bindtap="week">›</button></view><scroll-view scroll-x="{{!fitGrid}}" class="archive-scroll" style="height:{{height+headerHeight}}px;"><view class="{{selected.state.infoMode==='compact'?'compact-grid':''}}" style="width:{{width}}px;"><view class="grid-head"><view class="time-head">时间</view><view wx:for="{{days}}" wx:key="day" style="width:{{item.width}}px;" class="day-head">{{item.name}}<view>{{item.date}}</view><view class="holiday">{{item.holiday.cn}} {{item.holiday.de}} {{item.holiday.custom}}</view></view></view><view class="grid-body" style="height:{{height}}px;"><view class="time-axis"><view wx:for="{{hours}}" wx:key="label" class="hour" style="top:{{item.top}}px;">{{item.label}}</view></view><view wx:for="{{days}}" wx:for-item="day" wx:key="day" class="column" style="width:{{day.width}}px;"><view wx:for="{{day.blocks}}" wx:for-item="course" wx:key="id" class="block {{selected.state.infoMode==='compact'?'compact-block':''}} {{course.collapsed?'number-block':''}}" data-id="{{course.id}}" bindtap="showDetails" style="top:{{course.top}}px;height:{{course.height}}px;left:{{course.leftPct}}%;width:{{course.widthPct}}%;border-left-color:{{course.courseColor}};"><view wx:if="{{course.collapsed}}" class="archive-number">{{course.number}}</view><scroll-view wx:else scroll-y class="block-content"><view wx:if="{{selected.state.infoMode==='compact'}}"><view class="bold">{{course.shortTitle||course.title}}</view><view>{{course.compactRoom}}</view></view><view wx:else><view class="bold">📖 {{course.title}}</view><view>{{course.type}} · {{course.start}}–{{course.end}}</view><view>每周 {{course.from}} 至 {{course.to}}</view><view>📍 {{course.room}} · {{course.building}}</view><view wx:if="{{course.teacher}}">👤 {{course.teacher}}</view><view wx:if="{{course.note}}">📝 {{course.note}}</view></view><view wx:if="{{course.examCount}}" class="archive-reminder">{{course.examLabel}}</view><view wx:if="{{course.homeworkCount}}" class="archive-reminder">{{course.homeworkLabel}}</view></scroll-view></view></view></view></view></scroll-view></view>
</view>
