.help-page{max-width:820px;margin:auto;padding:30rpx 28rpx 80rpx;padding-left:calc(28rpx + var(--safe-left, 0px));padding-right:calc(28rpx + var(--safe-right, 0px))}.help-hero{padding:24rpx 8rpx 36rpx}.help-eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#9c7b36}.help-title{font-size:44rpx;font-weight:800;margin:15rpx 0}.help-intro{color:#77879c;line-height:1.8;font-size:25rpx}.help-card{background:white;border:1rpx solid #e1e8f1;border-radius:20rpx;padding:28rpx;margin-bottom:22rpx}.card-title{font-size:30rpx;font-weight:700;color:#245e98;margin-bottom:18rpx}.help-line{font-size:25rpx;line-height:1.85;color:#4a6079;margin:14rpx 0;white-space:pre-wrap}.help-footer{font-size:23rpx;color:#8b7957;background:#fff7e5;padding:24rpx;border-radius:16rpx;line-height:1.8}.help-back{background:#e8f0fb;color:#245f9c;margin-top:28rpx;border-radius:14rpx}
@media(min-width:600px){.help-page{padding:24px 28px 60px;padding-left:calc(28px + var(--safe-left, 0px));padding-right:calc(28px + var(--safe-right, 0px))}.help-hero{padding:20px 4px 28px}.help-eyebrow{font-size:11px;letter-spacing:2px}.help-title{font-size:32px;margin:14px 0}.help-intro,.help-line{font-size:16px}.help-card{border-radius:16px;padding:24px;margin-bottom:18px}.card-title{font-size:20px;margin-bottom:14px}.help-line{margin:12px 0}.help-footer{font-size:13px;padding:18px;border-radius:12px}.help-back{font-size:15px;line-height:44px;margin-top:22px;border-radius:12px}}
