<view class="page" style="{{safeAreaStyle}}">
 <view class="top"><view><view class="eyebrow">STUDIUM · 学业记录</view><view class="title">成绩与学分</view></view><button class="plus" bindtap="addMenu" disabled="{{busy}}">＋</button></view>
 <view class="school" bindtap="editSchool"><view class="logo-box {{school.abbr==='FAU'?'fau':''}}"><image wx:if="{{school.logo}}" class="logo" src="{{school.logo}}" mode="aspectFit" binderror="logoError"/><text wx:else class="school-mark">{{school.abbr||'◈'}}</text></view><view class="school-name"><view>{{school.full||'学校信息'}}</view><text>{{school.abbr?'（'+school.abbr+'）':'点击填写学校 / 补充Logo'}}</text></view><text class="chevron">›</text></view>
 <view class="summary-space"><view wx:if="{{overall}}" class="overall"><view><text class="metric-label">总学分 · ECTS</text><view class="metric">{{overall.credits}}</view><text class="tiny">已获 {{overall.earned}} · 已录入 {{overall.credits}}</text></view><view><text class="metric-label">德国加权平均分</text><view class="metric">{{overall.de}}</view><text class="tiny">计分学分 {{overall.weight}}</text></view></view><view wx:elif="{{terms.length}}" class="summary-hint">长按下方“成绩”，汇总目前全部学期</view></view>
 <view class="table"><view class="table-head"><view class="name-col" bindlongpress="clearAllGrades">课程名称<text class="clear-grades-hint">长按清空</text></view><view class="credits-col">学分</view><view class="grade-col" bindlongpress="calculateAll">成绩</view><view class="confirm-col"></view></view>
 <view wx:for="{{terms}}" wx:for-item="term" wx:key="id" class="term"><view class="term-head" data-id="{{term.id}}" bindtap="toggleTerm" bindlongpress="clearTermGrades"><view class="term-name">{{term.program}}<view>{{term.semester}}</view><text class="term-clear-hint">长按清空本学期</text></view><view class="term-total">{{term.summary.credits}} ECTS<view class="tiny">已获 {{term.summary.earned}}</view></view><text class="fold">{{term.collapsed?'⌄':'⌃'}}</text></view>
 <view wx:if="{{!term.collapsed}}"><view wx:for="{{term.groups}}" wx:for-item="group" wx:key="id" class="module-frame {{group.module?'has-module':''}}"><view wx:for="{{group.rows}}" wx:for-item="course" wx:key="id" class="course-row {{course.isChild?'module-child':'module-parent'}}"><view class="name-col course-name" data-term="{{term.id}}" data-id="{{course.id}}" bindtap="edit"><view class="tiny" wx:if="{{course.isChild}}">↳ 下属课程</view>{{course.title}}<view wx:if="{{course.parentTitle}}" class="tiny">所属主课：{{course.parentTitle}}</view><view wx:if="{{course.note}}" class="tiny course-note">📝 {{course.note}}</view><view class="tiny">{{group.module?'点击编辑整个模块':'点击编辑'}}{{course.include?'':' · 不计平均分'}}{{course.countCredits?'':' · 不计学分'}}</view></view><view class="credits-col">{{course.creditsLabel}}</view><view class="grade-col">{{course.gradeLabel}}<view class="tiny">{{course.scaleLabel}}</view></view><view class="confirm-col"><button class="confirm" data-id="{{term.id}}" bindtap="confirmTerm">确认</button></view></view><view wx:if="{{group.relation}}" class="module-relation">{{group.relation}}</view></view>
 <view wx:if="{{term.calculated}}" class="term-result"><view><text>德国平均分</text><view>{{term.summary.de}}</view></view><view><text>4.0 GPA · 参考</text><view>{{term.summary.gpa}}</view></view><view><text>百分制 · 参考</text><view>{{term.summary.percent}}</view></view></view></view></view></view>
 <view wx:if="{{terms.length}}" class="calculation-note">学分在录入后更新，平均分需确认计算。已获学分不含未出分与不及格记录；德国平均分仅包含通过且计入平均的有分数课程，保留两位小数。实际毕业成绩以考试条例为准。</view>
 <view wx:if="{{notice}}" class="notice">{{notice}}</view>
 <view wx:for="{{importResult.warnings}}" wx:key="*this" class="notice">{{item}}</view>
 <view wx:if="{{importRows.length}}" class="import-box"><view class="section-title">核对成绩识别结果</view><view wx:if="{{importResult.logoCandidate}}" class="logo-preview"><image src="{{'data:image/png;base64,'+importResult.logoCandidate}}" mode="aspectFit"/><view>识别到页首图片，确认是学校Logo后启用<switch checked="{{useLogo}}" bindchange="useImportedLogo"/></view></view><view wx:if="{{importResult.school.full}}" class="hint">学校：{{importResult.school.full}}（{{importResult.school.abbr}}）</view><view wx:for="{{importGroups}}" wx:for-item="group" wx:key="id" class="module-frame has-module"><view wx:for="{{group.rows}}" wx:key="id" class="preview-row {{item.isChild?'module-child':'module-parent'}}"><view class="tiny" wx:if="{{item.isChild}}">↳ 下属课程</view><textarea auto-height class="field group-title" value="{{item.title}}" data-index="{{item._index}}" data-field="title" bindinput="changeImport" placeholder="课程代码＋名称"/><view class="pair"><view class="input-cell"><view class="label">学分 · ECTS</view><input value="{{item.credits}}" data-index="{{item._index}}" data-field="credits" bindinput="changeImport" placeholder="{{item.recordKind==='module'?'未列出，可留空':'可填0'}}"/></view><view class="input-cell"><view class="label">成绩（选填）</view><input value="{{item.grade}}" data-index="{{item._index}}" data-field="grade" bindinput="changeImport" placeholder="未出分留空"/></view></view><view wx:if="{{item.parentTitle}}" class="tiny">所属模块：{{item.parentTitle}}</view><view wx:if="{{item.countCredits===false}}" class="tiny">此项默认不计学分及平均分（避免模块重复计分；未列学分时不计分）</view><view class="tiny">{{item.scale==='percent'?'百分制':item.scale==='gpa'?'4.0 GPA':'德国成绩'}} · {{item.status==='pass'?'通过不计分':item.status==='pending'?'待出分':'有分数'}}（导入后可点课程修改）</view><view class="label">专业</view><input value="{{item.program}}" data-index="{{item._index}}" data-field="program" bindinput="changeImport" placeholder="专业，例如Mechatronik"/><view class="label">本课程所属学期</view><input value="{{item.semester}}" data-index="{{item._index}}" data-field="semester" bindinput="changeImport" placeholder="例如Wintersemester 2026/27"/><view class="label">📝 本课程批注</view><textarea auto-height maxlength="3000" class="field note-field" value="{{item.note}}" data-index="{{item._index}}" data-field="note" bindinput="changeImport" placeholder="可补充考试资格、作业等要求"/><button class="text-button" data-index="{{item._index}}" bindtap="removeImport">不导入此条</button></view><view wx:if="{{group.relation}}" class="module-relation">{{group.relation}}</view></view><button class="primary" bindtap="confirmImport">确认追加成绩</button></view>
 <view wx:if="{{importText}}"><button class="text-button" bindtap="toggleText">{{showText?'收起':'查看'}}提取文字</button><view wx:if="{{showText}}" class="extracted">{{importText}}</view></view>
 <button class="text-button" bindtap="localPDFHelp">手机本地 PDF 如何导入？</button><view class="footer"><button bindtap="openRules">计算规则</button><button bindtap="backup">复制成绩备份</button><button bindtap="restore">导入成绩备份</button></view><view class="footnote">数据保存在本机。上传成绩单由你的云函数处理；图片 / 扫描件另调用腾讯云OCR。学校Logo仅作学校识别标识。4.0 GPA / 百分制为参考换算；英国院校没有统一 GPA 对照，不视为官方认证成绩。</view>
 <view wx:if="{{editor||schoolEditor||rulesEditor}}" class="mask" catchtouchmove="noop"><scroll-view scroll-y scroll-into-view="{{editorTarget}}" class="dialog"><view class="dialog-content"><view id="editor-top"></view>
 <view wx:if="{{editor && !groupEditor}}"><view class="section-title">{{editCourse?'编辑成绩记录':'添加课程成绩'}}</view><view class="label">专业</view><input bindfocus="editorFieldFocus" class="field" value="{{form.program}}" data-field="program" bindinput="change" placeholder="Mechatronik"/><view class="label">学期</view><input bindfocus="editorFieldFocus" class="field" value="{{form.semester}}" data-field="semester" bindinput="change" placeholder="Wintersemester 2026/27 / Sommersemester 2027"/><view class="label">课程名称</view><input bindfocus="editorFieldFocus" class="field" value="{{form.title}}" data-field="title" bindinput="change"/><view class="label">学分 · ECTS</view><input bindfocus="editorFieldFocus" class="field" value="{{form.credits}}" data-field="credits" bindinput="change" type="digit"/><view class="label">成绩体系</view><picker range="{{scaleOptions}}" value="{{scaleIndex}}" bindchange="scale"><view class="field">{{scaleOptions[scaleIndex]}} ⌄</view></picker><picker range="{{statusOptions}}" value="{{statusIndex}}" bindchange="status"><view class="field">{{statusOptions[statusIndex]}} ⌄</view></picker><view class="label">本课程成绩（选填，填写后自动切换为有分数）</view><input bindfocus="editorFieldFocus" class="field" value="{{form.grade}}" data-field="grade" bindinput="change" placeholder="分数（暂未出分可留空）"/><view class="switch">计入学分<switch checked="{{form.countCredits}}" data-field="countCredits" bindchange="change"/></view><view class="switch">计入平均分<switch checked="{{form.include}}" data-field="include" bindchange="change"/></view><view class="label">📝 本课程批注</view><textarea bindfocus="editorFieldFocus" auto-height maxlength="3000" class="field note-field" value="{{form.note}}" data-field="note" bindinput="change" placeholder="例如：作业提交率达到50%才能参加考试"/><button class="secondary" bindtap="addChild">＋ 添加下属课程（Übung / Tut / Teil）</button><button class="primary" bindtap="saveCourse">保存记录，仅更新学分</button><button wx:if="{{editCourse}}" class="danger" bindtap="removeCourse">删除记录</button></view>
 <view wx:if="{{editor && groupEditor}}"><view class="section-title">编辑模块与下属课程</view><view class="label">专业 / 主课所属学期（下属课程可分别设置）</view><input bindfocus="editorFieldFocus" class="field" value="{{groupProgram}}" data-field="groupProgram" bindinput="changeGroupTerm" placeholder="专业"/><input bindfocus="editorFieldFocus" class="field" value="{{groupSemester}}" data-field="groupSemester" bindinput="changeGroupTerm" placeholder="学期"/><view class="module-frame has-module"><view wx:for="{{groupForms}}" wx:key="id" id="grade-row-{{item.id}}" class="group-edit-row {{index>0?'module-child':'module-parent'}}"><view class="label">{{index>0?'↳ 下属课程 · '+(item.courseType||''):'模块主项 · 总成绩'}}</view><textarea bindfocus="editorFieldFocus" auto-height class="field group-title" value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="changeGroup" placeholder="课程代码＋名称"/><view wx:if="{{index>0}}"><view class="label">本下属课程的学期</view><input bindfocus="editorFieldFocus" class="field" value="{{item.semester}}" data-index="{{index}}" data-field="semester" bindinput="changeGroup" placeholder="例如 Sommersemester 2027"/></view><view class="label">学分 · ECTS（可以为0）</view><input bindfocus="editorFieldFocus" class="field" value="{{item.credits}}" data-index="{{index}}" data-field="credits" bindinput="changeGroup" type="digit" placeholder="{{index>0?'学分':'原件未列学分，可留空'}}"/><picker range="{{scaleOptions}}" value="{{item.scaleIndex}}" data-index="{{index}}" bindchange="groupScale"><view class="field">{{scaleOptions[item.scaleIndex]}} ⌄</view></picker><picker range="{{statusOptions}}" value="{{item.statusIndex}}" data-index="{{index}}" bindchange="groupStatus"><view class="field">{{statusOptions[item.statusIndex]}} ⌄</view></picker><view class="label">{{index>0?'下属课程成绩':'主课总成绩'}}（选填）</view><input bindfocus="editorFieldFocus" class="field" value="{{item.grade}}" data-index="{{index}}" data-field="grade" bindinput="changeGroup" placeholder="成绩，未出分可留空"/><view class="switch">计入学分<switch checked="{{item.countCredits}}" data-index="{{index}}" data-field="countCredits" bindchange="changeGroup"/></view><view class="switch">计入平均分<switch checked="{{item.include}}" data-index="{{index}}" data-field="include" bindchange="changeGroup"/></view><view class="label">📝 {{index>0?'下属课程':'主课'}}批注</view><textarea bindfocus="editorFieldFocus" auto-height maxlength="3000" class="field note-field" value="{{item.note}}" data-index="{{index}}" data-field="note" bindinput="changeGroup" placeholder="作业、出勤、考试资格等要求"/><button wx:if="{{index>0}}" class="text-button" data-index="{{index}}" bindtap="removeChild">移除这门下属课程</button></view></view><button class="secondary" bindtap="addChild">＋ 添加下属课程（Übung / Tut / Teil）</button><view class="pair"><button class="text-button" bindtap="useParentTotals">按主课计分</button><button class="text-button" bindtap="useChildTotals">按下属课程计分</button></view><view class="hint">主课与下属课程各自保留成绩和批注。模块未列学分时保留空白；模块与子项只选择一层计分。</view><button class="primary" bindtap="saveCourse">保存整个模块，仅更新学分</button><button class="danger" bindtap="removeCourse">删除整个模块及下属记录</button></view>
 <view wx:if="{{schoolEditor}}"><view class="section-title">学校信息</view><view class="label">学校全称</view><input class="field" value="{{schoolForm.full}}" data-field="full" bindinput="changeSchool"/><view class="label">学校缩写</view><input class="field" value="{{schoolForm.abbr}}" data-field="abbr" bindinput="changeSchool"/><button class="secondary" bindtap="chooseLogo">选择 / 替换学校Logo</button><view class="hint">识别到FAU时自动匹配官网Logo。其他学校可补充真实Logo，不会生成仿制标志。</view><button class="primary" bindtap="saveSchool">保存学校信息</button></view>
 <view wx:if="{{rulesEditor}}"><view class="section-title">计算与参考换算</view><view class="hint">德国平均分 = Σ(德国成绩 × 学分) ÷ 计分学分。未出分、通过不计分、不及格课程不计入平均，已获学分单独统计。校规中的模块特殊权重、重修替代及截断方式需自行核对。</view><view class="label">百分制最高分</view><input class="field" value="{{ruleForm.percentBest}}" data-field="percentBest" bindinput="changeRule" type="digit"/><view class="label">百分制及格分</view><input class="field" value="{{ruleForm.percentPass}}" data-field="percentPass" bindinput="changeRule" type="digit"/><view class="hint">参考百分制 = 最高分 − (德国成绩 − 1) × (最高分 − 及格分) ÷ 3。反向换算采用修订巴伐利亚公式；这不是学校官方成绩认证。</view><picker range="{{['百分制×4/100（你提供的公式）','等级简表：90/80/70/60→4/3/2/1']}}" value="{{gpaIndex}}" bindchange="gpaRule"><view class="field">{{gpaIndex?'等级简表（参考）':'百分制 × 4 / 100'}} ⌄</view></picker><view class="hint">GPA 对每门课先换算，再按所有计入且有分数课程的学分加权（包括未通过）。与德国平均分分母不同。等级简表不推测 B+ 等细分区间。</view><button class="primary" bindtap="saveRules">保存规则，清除旧计算结果</button></view>
 <button class="close" bindtap="closeEditor">取消 / 返回</button></view></scroll-view></view>
</view>
