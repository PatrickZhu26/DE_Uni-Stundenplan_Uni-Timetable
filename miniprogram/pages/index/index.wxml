<view class="page {{fitGrid?'tablet-layout':''}}" style="{{safeAreaStyle}}">
  <view wx:if="{{!isEditor}}">
    <view class="hero">
      <view wx:if="{{courses.length && (meta.school || meta.semester)}}" class="eyebrow">{{meta.school}}{{meta.school && meta.semester ? ' · ' : ''}}{{meta.semester}}</view>
      <view class="hero-top"><view class="headline">我的课程表 <text class="star mode-toggle" bindtap="toggleInfoMode" aria-role="button" aria-label="切换课程表信息显示">✦</text></view><view class="hero-tools"><button class="hero-tool help-tool {{helpRead?'help-read':''}}" bindtap="openHelp"><text class="help-bulb">💡</text> 使用说明</button><button class="hero-tool" bindtap="openArchives"><text>▣</text> 保存学期课表</button><button class="hero-tool" bindtap="openGrades"><text>◷</text> 成绩与学分</button></view></view>
      <view class="subhead">{{infoMode==='compact'?'简洁信息 · 名称 / 简称与教室':'周课表 · 教室地址 · 学习批注'}}<text class="mode-hint">点击 ✦ 切换</text></view>
    </view>
    <view class="calendar-panel"><view class="week-nav"><button class="navbtn" data-delta="-1" bindtap="changeWeek">‹</button><view class="week-center"><text class="week-heading">{{weekLabel}}</text><text class="week-year">{{isCurrentWeek ? "德国今天 "+todayDate : weekStart}}</text></view><button class="navbtn" data-delta="1" bindtap="changeWeek">›</button><button class="today" bindtap="returnToday">本周</button></view>
    <scroll-view scroll-x="{{!fitGrid}}" class="day-scroll"><view class="days">
      <view wx:for="{{dayTabs}}" wx:key="day" class="day {{item.vacation?'vacation':(item.active?'active':'')}} {{item.vacation&&item.active?'vacation-selected':''}}" data-day="{{item.day}}" bindtap="changeDay">
        <text>{{item.name}}</text><text class="date">{{item.dateLabel}}</text><view class="holiday-dots"><view wx:if="{{item.cn}}" class="holiday-dot cn-dot"></view><view wx:if="{{item.de}}" class="holiday-dot de-dot"></view></view>
      </view>
    </view></scroll-view></view>
    <view class="agenda">
      <button class="agenda-toggle" bindtap="toggleAgenda" aria-expanded="{{agendaOpen}}">
        <text class="agenda-icon" aria-hidden="true">◷</text>
        <view class="agenda-heading">
          <view class="agenda-title">近期考试与作业</view>
          <view class="agenda-count">{{agenda.exams||0}} 场考试 · {{agenda.homework||0}} 项作业</view>
        </view>
        <text class="agenda-action">{{agendaOpen?'收起':'查看'}} <text aria-hidden="true">{{agendaOpen?'⌃':'›'}}</text></text>
      </button>
      <view wx:if="{{agendaOpen}}" class="agenda-body">
        <view wx:if="{{!agenda.rows.length}}" class="agenda-empty">近期没有未结束的考试或未截止的作业，可在课程编辑中添加。</view>
        <button wx:for="{{agenda.rows}}" wx:key="key" class="agenda-row" data-key="{{item.key}}" bindtap="openAgendaDetail">
          <view class="agenda-row-heading">
            <text class="agenda-kind {{item.kind==='exam'?'agenda-exam':'agenda-homework'}}">{{item.kind==='exam'?'考试':'作业'}}</text>
            <text class="agenda-status {{item.urgent?'agenda-urgent':''}}">{{item.status}}</text>
          </view>
          <view class="agenda-item-title">{{item.title}}</view>
          <view class="agenda-course">{{item.courseTitle}}</view>
          <view class="agenda-detail"><text>{{item.when}}</text><text wx:if="{{item.room}}">地点 {{item.room}}</text></view>
        </button>
        <button wx:if="{{agenda.hasMore}}" class="agenda-more" bindtap="showMoreAgenda">查看更多</button>
      </view>
    </view>
    <view class="holiday-legend"><text class="legend-cn">● 中国假日</text><text class="legend-de">● 德国假日</text><text>假期深蓝 · 选中显示细灰边</text></view>
    <view wx:if="{{holidayNotice}}" class="notice">{{holidayNotice}}</view>
    <view wx:if="{{schoolCancellations.length}}" class="school-cancellations">
      <view class="school-cancellations-title">学校日历标记停课</view>
      <view wx:for="{{schoolCancellations}}" wx:key="id" class="school-cancellation" data-id="{{item.id}}" bindtap="openEdit">
        <text class="school-cancellation-time">{{item.day}} {{item.date}} · {{item.start}}–{{item.end}}</text>
        <text>{{item.title}}</text>
      </view>
    </view>
    <view class="grid-heading"><view class="section-title">{{infoMode==='compact'?'简洁周课表':'完整周课表'}}</view><view class="mini-desc">{{fitGrid?'整周适配屏幕 · 课程块内滑动查看详情':'左右滑动 · 冲突课程并排'}} · 长按课程移动 · 长按空白时段添加</view></view>
    <view class="display-settings">
      <view class="settings-toggle" bindtap="toggleSettings"><text>课表显示设置 · Anzeige</text><text>{{settingsOpen?'⌃':'⌄'}}</text></view>
      <view wx:if="{{settingsOpen}}" class="settings-content">
        <view class="display-times">
          <view class="display-time"><view class="field-label">开始时间 · Uhrzeit von</view><picker mode="time" value="{{viewDraft.start}}" data-field="start" bindchange="changeViewTime"><view class="display-picker">{{viewDraft.start}}　⌄</view></picker></view>
          <view class="display-time"><view class="field-label">结束时间 · Uhrzeit bis</view><picker mode="time" value="{{viewDraft.end}}" data-field="end" bindchange="changeViewTime"><view class="display-picker">{{viewDraft.end}}　⌄</view></picker></view>
        </view>
        <view class="field-label">显示星期 · Wochentage</view><checkbox-group bindchange="changeViewDays" class="display-days"><label wx:for="{{viewDayOptions}}" wx:key="value" class="display-day"><checkbox value="{{item.value}}" checked="{{item.checked}}" color="#216cbd"/><text>{{item.label}}</text></label></checkbox-group>
        <view class="display-actions"><button bindtap="applyView">应用并保存</button><button bindtap="resetView">恢复默认</button></view>
        <view wx:if="{{courses.length}}" class="school-settings">
          <view class="backup-title">学校与学期</view>
          <view class="settings-inputs">
            <view class="settings-field"><view class="field-label">学校缩写或名称</view><input class="settings-input" value="{{meta.school}}" maxlength="200" data-field="school" bindinput="changeMeta" placeholder="例如 FAU"/></view>
            <view class="settings-field"><view class="field-label">学期</view><input class="settings-input" value="{{meta.semester}}" maxlength="100" data-field="semester" bindinput="changeMeta" placeholder="例如 Wintersemester 2026/27"/></view>
          </view>
          <button class="small-secondary" bindtap="saveMeta">保存学校与学期</button>
        </view>
        <view class="holiday-settings">
          <view class="backup-title">节假日设置 · Feiertage und Ferien</view>
          <view class="mini-desc">按学校所在州显示法定假日。寒暑假、圣诞假等请按学校校历添加。</view>
          <view class="field-label setting-label">学校所在德国州 · Bundesland</view><picker range="{{states}}" range-key="name" value="{{stateIndex}}" bindchange="changeState"><view class="display-picker">{{states[stateIndex].name}}　⌄</view></picker>
          <view class="switch-row"><text>德国法定假日停课</text><switch checked="{{holiday.skipDE}}" data-field="skipDE" bindchange="changeHolidaySwitch" color="#176751"/></view>
          <view wx:if="{{localOptions.length}}" class="local-settings">
            <view class="local-toggle" bindtap="toggleLocalSettings"><text>市镇假日（选填）{{holiday.local.length ? ' · 已选 '+holiday.local.length+' 项' : ''}}</text><text>{{localSettingsOpen ? '⌃' : '⌄'}}</text></view>
            <checkbox-group wx:if="{{localSettingsOpen}}" bindchange="changeLocal">
              <label wx:for="{{localOptions}}" wx:key="value" class="local-option"><checkbox value="{{item.value}}" checked="{{item.checked}}" color="#216cbd"/><text>{{item.label}}</text></label>
              <view class="mini-desc">适用范围因市镇而异，请以校区所在地为准。</view>
            </checkbox-group>
          </view>
          <view class="switch-row"><text>中国假日停课</text><switch checked="{{holiday.skipCN}}" data-field="skipCN" bindchange="changeHolidaySwitch" color="#176751"/></view>
          <view class="mini-desc">中国红点按2026年官方放假安排（含调休休息日）显示；调休上班日仅注释，不自动改动德国课程。2025–2035年支持法定节日本日（含农历节日），其中除2026年外的连休/调休须按官方通知补充。</view>
          <view class="holiday-form"><view class="field-label">自定义假期名称</view><input class="settings-input" maxlength="100" value="{{holidayForm.name}}" data-field="name" bindinput="changeHolidayForm" placeholder="例如 Weihnachtsferien"/><view class="display-times"><picker class="display-time" mode="date" value="{{holidayForm.from}}" data-field="from" bindchange="changeHolidayForm"><view class="display-picker">从 {{holidayForm.from}}</view></picker><picker class="display-time" mode="date" value="{{holidayForm.to}}" data-field="to" bindchange="changeHolidayForm"><view class="display-picker">至 {{holidayForm.to}}</view></picker></view><view class="switch-row"><text>这段假期停课</text><switch checked="{{holidayForm.suspend}}" data-field="suspend" bindchange="changeHolidayForm" color="#176751"/></view><button class="small-secondary" bindtap="addHoliday">添加自定义假期</button></view>
          <view wx:for="{{holiday.custom}}" wx:key="id" class="custom-holiday"><view><text>{{item.name}}</text><view class="mini-desc">{{item.from}} — {{item.to}} · {{item.suspend?'停课':'仅标记'}}</view></view><button size="mini" data-id="{{item.id}}" bindtap="removeHoliday">删除</button></view>
        </view>
      </view>
    </view>
    <scroll-view scroll-x="{{!fitGrid}}" scroll-left="{{gridScrollLeft}}" scroll-with-animation="{{false}}" bindscroll="onGridScroll" class="timetable-scroll" style="height:{{gridHeight+gridHeaderHeight+2}}px;" enhanced show-scrollbar="{{!fitGrid}}">
      <view class="timetable {{infoMode==='compact'?'compact-grid':''}}" style="width:{{gridWidth}}px;">
        <view class="timetable-header"><view class="time-header">时间</view><view wx:for="{{gridDays}}" wx:key="day" class="grid-day-header {{item.holiday.vacation?'holiday-header':''}}" style="width:{{item.width}}px;"><text>{{item.name}}</text><text class="grid-date">{{item.date}}</text><text wx:if="{{item.holiday.cn}}" class="header-cn">{{item.holiday.cn}}</text><text wx:if="{{item.holiday.de}}" class="header-de">{{item.holiday.de}}</text><text wx:if="{{item.holiday.custom}}" class="header-custom">{{item.holiday.custom}}</text><text wx:if="{{item.holiday.cnWork}}" class="header-custom">中国调休上班日</text><text wx:if="{{item.holiday.suspended}}" class="header-custom">假期停课</text></view></view>
        <view class="grid-body" style="height:{{gridHeight}}px;"><view class="grid-time-axis" style="height:{{gridHeight}}px;"><view wx:for="{{gridHours}}" wx:key="label" class="hour-label" style="top:{{item.labelTop}}px;">{{item.label}}</view></view>
          <view wx:for="{{gridDays}}" wx:for-item="column" wx:key="day" id="column-{{column.day}}" data-day="{{column.day}}" bindlongpress="addAtBlank" class="grid-day-column {{column.holiday.suspended?'suspended-column':''}}" style="width:{{column.width}}px;height:{{gridHeight}}px;">
            <view wx:for="{{gridHours}}" wx:for-item="hour" wx:key="label" class="hour-rule" style="top:{{hour.top}}px;"></view>
            <view wx:for="{{column.blocks}}" wx:for-item="course" wx:key="id" class="grid-course {{infoMode==='compact'?'compact-course':''}} {{course.collapsed?'number-course':''}} {{!course.collapsed&&(course.homeworkCount||course.examCount)?'has-alert':''}}" style="top:{{course.top}}px;height:{{course.height}}px;left:{{course.leftPct}}%;width:{{course.widthPct}}%;border-left-color:{{course.courseColor}};" data-id="{{course.id}}" bindtap="openEdit" bindtouchstart="cardTouchStart" catchlongpress="dragStart" capture-catch:touchmove="{{dragging?'dragMove':''}}" bindtouchmove="dragMove" bindtouchend="dragEnd" bindtouchcancel="dragCancel">
              <view wx:if="{{course.collapsed}}" class="course-number"><text>{{course.number}}</text><view wx:if="{{course.homeworkCount||course.examCount}}" class="reminder-dot"></view></view>
              <view wx:if="{{!course.collapsed&&(course.homeworkCount||course.examCount)}}" class="course-alerts">
                <view wx:if="{{course.homeworkCount}}" class="course-alert homework-alert {{course.homeworkUrgent?'alert-urgent':''}}" aria-role="button" aria-label="查看本课程作业与截止时间" data-id="{{course.id}}" catchtap="openCourseHomework"><view class="alert-title"><text class="alert-symbol">!</text><text>作业 {{course.homeworkCount}}项{{course.homeworkUrgent?' · 即将截止':''}}</text></view><view class="alert-deadline">{{course.homeworkDueLabel}}</view></view>
                <view wx:if="{{course.examCount}}" class="course-alert exam-alert"><view class="alert-title">◷ {{course.examLabel}}</view></view>
              </view>
              <scroll-view wx:if="{{!course.collapsed}}" id="card-scroll-{{course.id}}" data-id="{{course.id}}" scroll-y="{{!dragging}}" enhanced bounces="{{false}}" bindscroll="onCardScroll" class="grid-course-content"><view id="card-inner-{{course.id}}">
                <view wx:if="{{infoMode==='compact'}}" class="compact-info"><view class="compact-title">{{course.shortTitle||course.title}}</view><view class="compact-room">{{course.compactRoom}}</view></view>
                <view wx:else class="full-info"><view class="grid-course-title">📖 {{course.title}}</view>
                <view class="grid-course-line">{{course.type}}</view>
                <view class="grid-course-line grid-strong">{{course.start}}–{{course.end}}</view>
                <view class="grid-course-line">{{course.dateLabel}}</view>
                <view class="grid-course-line grid-address" data-id="{{course.id}}" catchtap="navigateCourse">📍 {{course.room||'教室未填写'}} · 地图选项 ↗</view>
                <view wx:if="{{course.building}}" class="grid-course-line grid-address" data-id="{{course.id}}" catchtap="navigateCourse">{{course.building}}</view>
                <view wx:if="{{course.teacher}}" class="grid-course-line">👤 {{course.teacher}}</view>
                <view wx:if="{{course.note}}" class="grid-course-line grid-course-note">📝 {{course.note}}</view>
                <view wx:if="{{course.conflict}}" class="grid-conflict">⚠ 同时段课程</view>
                <view class="grid-course-line">点击查看 / 编辑 / 批注</view></view>
              </view></scroll-view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{dragging&&dragGhost}}" class="drag-ghost" style="left:{{dragGhost.x}}px;top:{{dragGhost.y}}px;">{{dragGhost.title}}</view>
    <view class="add-section"><button class="add-btn" bindtap="openAdd">＋ 添加</button></view>
    <view wx:if="{{totalConflicts}}" class="conflict-summary">{{totalConflicts}} 个冲突课程 · 以下按日期列出</view>
    <view wx:for="{{dayGroups}}" wx:for-item="group" wx:key="day" class="day-detail-group">
      <view wx:if="{{group.conflictCount}}" class="day-conflict">{{group.conflictCount}} 个冲突课程</view>
      <view class="section-title">{{group.name}}</view><view class="section-hint">{{group.sessionCount}} 个课时 · {{group.courseCount}} 门课</view>
      <view wx:if="{{group.holiday.suspended}}" class="notice">假期停课：{{group.holiday.de}} {{group.holiday.cn}} {{group.holiday.custom}}。以下保留原课程信息供查看和编辑。</view>
      <view wx:if="{{!group.items.length}}" class="empty">这一天尚无课程，可点击“添加”或上传课表。</view>
      <view wx:for="{{group.items}}" wx:for-item="course" wx:key="id" class="course" style="border-left-color:{{course.courseColor}};"><view class="course-head"><view class="time">{{course.start}} — {{course.end}}</view><text class="type">{{course.type}}</text></view><view class="course-name">{{course.title}}</view><view wx:if="{{course.conflict}}" class="warning">⚠ 与当天其他课程时间重叠</view><view class="info grid-address" data-id="{{course.id}}" bindtap="navigateCourse">📍 {{course.building||'地址未填写'}} · {{course.room}}</view><view wx:if="{{course.teacher}}" class="info">👤 {{course.teacher}}</view><view class="mini-desc">{{course.dateLabel}}</view><view wx:if="{{course.note}}" class="note">📝 {{course.note}}</view><view class="actions"><button size="mini" class="act" data-id="{{course.id}}" bindtap="openEdit">编辑 / 批注</button><button size="mini" class="act" data-id="{{course.id}}" bindtap="copyLocation">复制地点</button><button size="mini" class="act" data-id="{{course.id}}" bindtap="copyCourse">复制详情</button></view></view>
    </view>
    <view wx:if="{{courses.length}}" class="controls"><view class="secondary-link" bindtap="toggleAll">{{showAll?'仅显示本周有效课程':'显示全部学期日期的课程'}}</view></view>
    <view class="backup"><view class="backup-title">导入大学课表</view><view class="import-actions"><button class="import-button" bindtap="choosePDF" loading="{{importBusy}}" disabled="{{importBusy}}">选择 PDF / ICS 文件</button><button wx:if="{{courses.length||baseline}}" class="clear-button" bindtap="clearSchedule" disabled="{{importBusy}}">清空课表及信息</button></view><view class="secondary-link" bindtap="localPDFHelp">本地课表文件如何导入？</view><input class="url-input" value="{{importUrl}}" maxlength="4096" bindinput="changeImportUrl" placeholder="粘贴学校导出的 PDF 或 iCalendar 链接"/><button class="import-button" bindtap="importPDFUrl" loading="{{importBusy}}" disabled="{{importBusy}}">识别输入的链接</button><view class="mini-desc">可导入文本型 PDF、iCalendar（ICS）文件或学校的 HTTPS 导出链接。学校只提供下载按钮时，可先下载文件再导入。文件最大 16 MB，PDF 最多 30 页。</view>
      <view class="import-message">{{importMessage}}</view><view wx:for="{{importWarnings}}" wx:key="*this" class="notice">{{item}}</view>
      <view wx:if="{{importPreview.length}}"><view class="backup-title">核对识别结果 · {{importPreview.length}} 个课时</view><input class="url-input" value="{{importMeta.school}}" maxlength="200" data-field="school" bindinput="changeImportMeta" placeholder="学校缩写 / 名称（未识别时可填写）"/><input class="url-input" value="{{importMeta.semester}}" maxlength="100" data-field="semester" bindinput="changeImportMeta" placeholder="学期（未识别时可填写）"/><picker range="{{states}}" range-key="name" value="{{importStateIndex}}" bindchange="changeImportState"><view class="display-picker">{{states[importStateIndex].name}}　⌄</view></picker><picker range="{{importModes}}" value="{{importMode}}" bindchange="changeImportMode"><view class="display-picker">{{importModes[importMode]}}　⌄</view></picker>
        <view wx:for="{{importPreview}}" wx:key="id" class="preview-row"><view>{{dayNames[item.day]}} {{item.start}}–{{item.end}} · {{item.title}}</view><view class="mini-desc">{{item.type}} · {{item.dateLabel}}
{{item.room}} · {{item.building}}
{{item.teacher}}</view><view wx:if="{{item.sourceCancelledDates.length}}" class="mini-desc">学校日历标记停课 {{item.sourceCancelledDates.length}} 次</view><view class="actions"><button size="mini" data-index="{{index}}" bindtap="editPreview">核对 / 编辑</button><button size="mini" data-index="{{index}}" bindtap="removePreview">移除</button></view></view><button class="import-button" bindtap="confirmPDFImport">确认导入并保存原版</button>
      </view><view wx:if="{{extractedText}}"><view class="secondary-link" bindtap="toggleExtracted">{{showExtracted?'收起提取文字':'查看PDF提取文字'}}</view><text wx:if="{{showExtracted}}" selectable class="extracted-text">{{extractedText}}</text></view>
    </view>
    <view class="backup"><view class="backup-title">课表数据管理</view><button class="import-button" bindtap="exportSchedule" loading="{{exportBusy}}" disabled="{{exportBusy}}">导出完整课表</button><button wx:if="{{lastPDF}}" class="small-secondary" bindtap="sharePDF">发送 PDF 给微信好友</button><button wx:if="{{lastPDF}}" class="small-secondary" bindtap="previewPDF">预览 / 保存 PDF</button><view class="backup-buttons"><button bindtap="exportData">复制JSON备份</button><button bindtap="importData">导入JSON备份</button><button bindtap="reset">恢复导入原版</button></view><view class="mini-desc">PDF用于查看和保存，包含全部课程详情。本程序导出的PDF也可重新导入。JSON备份用于完整恢复课程、批注、假期和显示设置。“恢复导入原版”回到最近一次确认导入时的课表。</view></view>
  </view>
  <view wx:if="{{isEditor}}" class="editor"><view wx:if="{{!studyKind}}"><view class="editor-head"><button class="back" bindtap="closeEditor">‹ 返回</button><view class="editor-title">{{previewEditIndex>=0?'核对识别课程':(editingId?'修改课程':'添加课程')}}</view></view>
    <view class="field"><view class="field-label">课程名称 *</view><input value="{{form.title}}" data-field="title" bindinput="changeText" placeholder="例如：Robotik"/></view>
    <view class="field"><view class="field-label">课程类型</view><picker mode="selector" range="{{typeOptions}}" value="{{formTypeIndex}}" data-field="type" bindchange="changePicker"><view class="picker">{{form.type}}　⌄</view></picker></view>
    <view class="field"><view class="field-label">星期</view><picker mode="selector" range="{{dayNames}}" value="{{form.day}}" data-field="day" bindchange="changePicker"><view class="picker">{{dayNames[form.day]}}　⌄</view></picker></view>
    <view class="pair"><view class="field half"><view class="field-label">开始时间 *</view><picker mode="time" value="{{form.start}}" data-field="start" bindchange="changePicker"><view class="picker">{{form.start}}</view></picker></view><view class="field half"><view class="field-label">结束时间 *</view><picker mode="time" value="{{form.end}}" data-field="end" bindchange="changePicker"><view class="picker">{{form.end}}</view></picker></view></view>
    <view class="pair"><view class="field half"><view class="field-label">开始日期 *</view><picker mode="date" value="{{form.from}}" data-field="from" bindchange="changePicker"><view class="picker">{{form.from}}</view></picker></view><view class="field half"><view class="field-label">结束日期 *</view><picker mode="date" value="{{form.to}}" data-field="to" bindchange="changePicker"><view class="picker">{{form.to}}</view></picker></view></view>
    <view class="field cancel-field" bindtap="openCancelCalendar"><view class="field-label">取消日期课程 <text class="field-arrow">›</text></view><view class="cancel-summary">{{form.cancelledDates.length?'已选择 '+form.cancelledDates.length+' 个取消日期':'选择不上课的日期'}}</view><view wx:if="{{form.cancelledDates.length}}" class="cancel-dates"><text wx:for="{{form.cancelledDates}}" wx:key="*this">{{item}}</text></view><view class="mini-desc">仅取消勾选日期的本课程，其余周照常上课。</view></view>
    <view class="field"><view class="field-label">课程简称（简洁课表选填）</view><input value="{{form.shortTitle}}" maxlength="40" data-field="shortTitle" bindinput="changeText" placeholder="例如 GET1 / IngMath"/><view wx:if="{{showPrimaryOption}}"><view class="switch-row"><text>主要显示在课表</text><switch checked="{{form.primary}}" bindchange="changePrimary" color="#2479d8"/></view><view class="mini-desc">{{editingId?'切换后立即保存并同步学期档案，返回即可查看；其他课程修改仍需点击下方保存。':(previewEditIndex>=0?'切换后保留在识别预览中，确认导入后生效。':'保存新课程后，在简洁课表中优先展示。')}}</view></view></view>
    <view class="field"><view class="field-label">教学楼 / 地址</view><input value="{{form.building}}" data-field="building" bindinput="changeText" placeholder="教学楼或街道地址"/></view>
    <view class="field"><view class="field-label">教室编号</view><input value="{{form.room}}" data-field="room" bindinput="changeText" placeholder="例如 H5 / 11501.01.104"/></view>
    <view class="field"><view class="field-label">任课教师</view><input value="{{form.teacher}}" data-field="teacher" bindinput="changeText" placeholder="教授 / 教师姓名"/></view>
    <view class="field"><view class="field-label">我的批注</view><textarea maxlength="3000" value="{{form.note}}" data-field="note" bindinput="changeText" placeholder="课前准备、作业、考试提醒、临时变动……" auto-height class="memo"/></view>
    <view class="study-entry" data-kind="exam" bindtap="openStudy"><view class="entry-icon exam-icon">◷</view><view class="entry-copy"><view class="entry-title">考试 <text>Prüfung</text></view><view class="entry-desc">考试日程、教室与备考笔记</view></view><text class="entry-count">{{form.exams.length||0}}</text><text class="entry-arrow">›</text></view>
    <view class="study-entry" data-kind="homework" bindtap="openStudy"><view class="entry-icon homework-icon">☷</view><view class="entry-copy"><view class="entry-title">作业 <text>Hausaufgaben</text></view><view class="entry-desc">截止日期、完成状态与课表提醒</view></view><text class="entry-count">{{form.homework.length||0}}</text><text class="entry-arrow">›</text></view>
    <view class="field"><view class="field-label">课程标签颜色</view><picker mode="selector" range="{{colorNames}}" value="{{form.color}}" data-field="color" bindchange="changePicker"><view class="picker">{{colorNames[form.color]}}　⌄</view></picker></view>
    <button class="save" bindtap="saveCourse">保存课程与批注</button><button wx:if="{{editingId}}" class="delete" bindtap="deleteCourse">删除此课时</button></view>
    <view wx:else class="study-page {{studyKind==='exam'?'exam-page':'homework-page'}}">
      <view class="study-nav"><button class="back" bindtap="closeStudy">‹ {{studyFromAgenda?'返回近期考试与作业':'返回课程'}}</button><text>{{studyKind==='exam'?'PRÜFUNG':'HAUSAUFGABEN'}}</text></view>
      <view class="study-hero"><view class="study-kicker">{{form.shortTitle||form.title||'我的课程'}}</view><view class="study-title">{{studyKind==='exam'?'为考试留出准备时间':'把每次截止记清楚'}}</view><view class="study-intro">{{studyKind==='exam'?'日程、地点、重点，一处收好。':'有效作业会显示在课表上，到期自动隐藏提醒。'}}</view></view>
      <view wx:if="{{!studyEditing}}">
        <button class="study-add" bindtap="editStudy">＋ {{studyKind==='exam'?'添加考试计划':'添加作业'}}</button>
        <view wx:if="{{!studyRows.length}}" class="study-empty"><view class="empty-symbol">{{studyKind==='exam'?'◷':'☷'}}</view><view>还没有{{studyKind==='exam'?'考试计划':'作业'}}</view><view class="entry-desc">{{studyKind==='exam'?'记录考试日期、教室与复习重点。':'添加名称与截止时间，课表会替你记着。'}}</view></view>
        <view wx:for="{{studyRows}}" wx:key="id" class="study-card {{item.done||item.expired?'study-muted':''}}"><view class="study-card-top"><view class="date-tile"><text>{{item.month}}月</text><view>{{item.day}}</view></view><view class="task-copy" data-id="{{item.id}}" bindtap="editStudy"><view class="task-title">{{item.title}}</view><view class="task-time">{{item.date}} · {{item.time}}{{item.end?' – '+item.end:''}}</view><view wx:if="{{item.room}}" class="task-location">⌖ {{item.room}}</view></view><view class="task-status {{item.urgent?'status-urgent':''}}">{{item.statusLabel}}</view></view><view wx:if="{{item.note}}" class="task-note">{{item.note}}</view><view class="task-actions"><button data-id="{{item.id}}" bindtap="toggleStudyDone">{{item.done?'恢复提醒':studyKind==='exam'?'标记结束':'标记完成'}}</button><button data-id="{{item.id}}" bindtap="editStudy">编辑</button><button class="task-delete" data-id="{{item.id}}" bindtap="deleteStudy">删除</button></view></view>
      </view>
      <view wx:else class="task-form"><view class="field"><view class="field-label">{{studyKind==='exam'?'考试名称':'作业名称'}} *</view><input value="{{studyForm.title}}" maxlength="160" data-field="title" bindinput="changeStudy" placeholder="{{studyKind==='exam'?'例如：Mathematik 期末考试':'例如：Übungsblatt 04'}}"/></view><view class="field"><view class="field-label">{{studyKind==='exam'?'考试日期':'截止日期'}} *</view><picker mode="date" value="{{studyForm.date}}" data-field="date" bindchange="changeStudy"><view class="picker">{{studyForm.date}}　⌄</view></picker></view><view class="pair"><view class="field half"><view class="field-label">{{studyKind==='exam'?'开始时间':'截止时间'}} *</view><picker mode="time" value="{{studyForm.time}}" data-field="time" bindchange="changeStudy"><view class="picker">{{studyForm.time}}</view></picker></view><view wx:if="{{studyKind==='exam'}}" class="field half"><view class="field-label">结束时间</view><picker mode="time" value="{{studyForm.end}}" data-field="end" bindchange="changeStudy"><view class="picker">{{studyForm.end||'选填'}}</view></picker></view></view><view wx:if="{{studyKind==='exam'}}" class="field"><view class="field-label">考试教室 / 地点</view><input value="{{studyForm.room}}" maxlength="200" data-field="room" bindinput="changeStudy" placeholder="例如 H5 · Cauerstraße 7"/></view><view class="field"><view class="field-label">{{studyKind==='exam'?'备考笔记':'作业说明'}}</view><textarea class="memo study-memo" auto-height maxlength="5000" value="{{studyForm.note}}" data-field="note" bindinput="changeStudy" placeholder="{{studyKind==='exam'?'考试范围、允许携带的物品、复习安排……':'题目要求、提交方式、需要准备的内容……'}}"/></view><button class="save study-save" bindtap="saveStudy">保存{{studyKind==='exam'?'考试计划':'作业'}}</button><view class="study-save-hint">{{editingId?'保存后立即更新课程与关联学期档案。':'新课程请在返回后点击“保存课程与批注”。'}} 提醒在小程序内显示。</view></view>
    </view>
  </view>
  <view wx:if="{{calendarOpen}}" class="calendar-mask" catchtouchmove="noop"><view class="calendar-dialog"><view class="calendar-title">取消日期课程</view><view class="calendar-subtitle">点选 {{dayNames[form.day]}} 的停课日期，可跨月多选。</view><view class="calendar-nav"><button data-delta="-1" bindtap="changeCalendarMonth">‹</button><text>{{calendarMonth}}</text><button data-delta="1" bindtap="changeCalendarMonth">›</button></view><view class="calendar-week"><text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><view wx:for="{{calendarCells}}" wx:key="date" data-date="{{item.date}}" bindtap="toggleCancelDate" class="calendar-cell {{item.available?'calendar-available':'calendar-disabled'}} {{item.selected?'calendar-selected':''}} {{!item.inMonth?'calendar-outside':''}}"><text>{{item.day}}</text><text wx:if="{{item.selected}}" class="calendar-check">✓</text></view></view><view class="calendar-count">已选 {{cancelDraft.length}} 个日期 · 保存课程后生效</view><view class="calendar-actions"><button bindtap="clearCancelDates">清除选择</button><button bindtap="closeCancelCalendar">取消</button><button class="calendar-confirm" bindtap="saveCancelDates">确定</button></view></view></view>
  <view wx:if="{{agendaDetail}}" class="agenda-mask">
    <view class="agenda-backdrop" catchtap="closeAgendaDetail" catchtouchmove="noop"></view>
    <view class="agenda-dialog {{agendaDetail.kind==='exam'?'agenda-dialog-exam':'agenda-dialog-homework'}}" aria-role="dialog" aria-label="{{agendaDetail.kind==='exam'?'考试详情':'作业详情'}}">
      <view class="agenda-dialog-header">
        <text class="agenda-dialog-status">{{agendaDetail.status}}</text>
        <text class="agenda-dialog-tag">{{agendaDetail.kind==='exam'?'考试':'作业'}}</text>
        <button class="agenda-gear" bindtap="editAgendaTask" aria-label="{{agendaDetail.kind==='exam'?'编辑考试':'编辑作业'}}">⚙</button>
      </view>
      <view class="agenda-dialog-body">
        <view class="agenda-dialog-title">{{agendaDetail.title}}</view>
        <view class="agenda-dialog-course">{{agendaDetail.courseTitle}}</view>
        <view class="agenda-facts">
          <view><text class="agenda-fact-label">{{agendaDetail.kind==='exam'?'考试时间':'截止时间'}}</text><view>{{agendaDetail.when}}</view></view>
          <view wx:if="{{agendaDetail.room}}"><text class="agenda-fact-label">地点</text><view>{{agendaDetail.room}}</view></view>
        </view>
        <view wx:if="{{agendaDetail.note}}" class="agenda-note">
          <text class="agenda-fact-label">{{agendaDetail.kind==='exam'?'备考笔记':'作业说明'}}</text>
          <view class="agenda-note-copy">{{agendaDetail.note}}</view>
        </view>
      </view>
      <view class="agenda-dialog-footer"><button bindtap="closeAgendaDetail">关闭</button></view>
    </view>
  </view>
  <canvas type="2d" id="exportCanvas" class="export-canvas"></canvas>
</view>
