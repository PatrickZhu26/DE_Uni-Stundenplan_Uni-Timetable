.calendar-actions button{min-height:38px;line-height:38px}.study-nav .back{margin:0!important;flex-shrink:0}.compact-grid .time-header,.compact-grid .grid-time-axis{width:44px;min-width:44px}.compact-grid .hour-label{font-size:10px;left:2px}.compact-grid .grid-day-header{font-size:13px;padding:10px 2px}.compact-grid .grid-date{font-size:10px}.compact-course{padding:7px 4px}.compact-title{font-size:12px;-webkit-line-clamp:5}.compact-room{font-size:11px;margin-top:6px}.number-course{padding:0;border-left-width:2px}.number-course .course-number{font-size:11px}.compact-course .course-reminder{padding:2px;font-size:9px}
