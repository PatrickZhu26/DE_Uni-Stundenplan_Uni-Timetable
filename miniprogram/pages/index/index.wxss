/* Tablets use the measured container as the entire week's width. */
.timetable-scroll{box-sizing:border-box}
.tablet-layout .timetable{min-width:0}
.tablet-layout .calendar-panel{width:100%;box-sizing:border-box;background:#fff;border:1px solid #e0e7f0;border-radius:20px;padding:12px 14px;margin:6px 0 14px}
.tablet-layout .week-nav{width:100%;max-width:none;margin:0;padding:0 0 12px;border-radius:0;box-shadow:none;border-bottom:1px solid #edf1f6;box-sizing:border-box}
.tablet-layout .day-scroll{width:100%;margin:12px 0 0;box-sizing:border-box}
.tablet-layout .days{width:100%;min-width:0;gap:8px}
.tablet-layout .day{flex:1;min-width:0;width:0;min-height:64px;border-radius:12px;background:#f3f6fb;color:#718197;font-size:13px}
.tablet-layout .day.active,.tablet-layout .day.vacation{background:#216cbd;color:white}
.tablet-layout .date{font-size:13px}
.tablet-layout .holiday-legend{margin-bottom:18px}
.tablet-layout .display-times{max-width:none}
.tablet-layout .display-time{min-width:0}
.tablet-layout .grid-course-title{font-size:13px;line-height:1.4}
.tablet-layout .grid-course-line{font-size:11px;line-height:1.45;word-break:break-word}
.tablet-layout .grid-day-header{font-size:15px}
.tablet-layout .compact-grid .grid-day-header{font-size:13px}
.grid-course.has-alert{display:flex;flex-direction:column}
.has-alert .grid-course-content{height:0;min-height:0;flex:1}
.course-alerts{flex-shrink:0;margin:-7px -6px 6px;max-height:48%;overflow:hidden;box-sizing:border-box}
.course-alert{padding:4px 5px;box-sizing:border-box;line-height:1.3}
.homework-alert{background:#fff0cc;color:#945d13;border-bottom:1px solid #efd5a1}
.alert-urgent{background:#ffe1d9;color:#ac3e2e;border-color:#eeb4a5}
.alert-title{font-size:10px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.4}
.alert-symbol{display:inline-flex;width:11px;height:11px;align-items:center;justify-content:center;flex-shrink:0;border-radius:50%;background:currentColor;font-size:0;margin-right:4px;vertical-align:middle}
.alert-symbol::after{content:'!';font-size:9px;color:#fff}
.alert-deadline{font-size:10px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px;line-height:1.3}
.exam-alert{background:#eee8fc;color:#6d55aa;border-bottom:1px solid #d9cef2}
.compact-course .course-alerts{margin-left:-4px;margin-right:-4px}
@media(min-width:750px){.tablet-layout .hero{padding:20px 0 22px}.tablet-layout .calendar-panel{padding:14px 18px}.tablet-layout .days{gap:12px}.tablet-layout .day{min-height:68px;font-size:14px}.tablet-layout .date{font-size:14px}.tablet-layout .grid-heading{margin-top:18px}}
.page{padding-left:calc(26rpx + var(--safe-left, 0px));padding-right:calc(26rpx + var(--safe-right, 0px))}
.calendar-dialog{max-height:calc(100vh - 32px)}
@media(min-width:600px){.page{padding-left:calc(28px + var(--safe-left, 0px));padding-right:calc(28px + var(--safe-right, 0px))}}
@media(max-height:500px){.calendar-dialog{max-height:calc(100vh - 16px)}}
/* Native scroll-view needs an explicit height when horizontal scrolling is disabled. */
.tablet-layout .day-scroll,.tablet-layout .days{height:76px}
