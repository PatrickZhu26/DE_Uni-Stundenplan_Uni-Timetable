/* 横向可滚动、纵向时间轴等比例的课程网格；每个冲突簇独立扩展当天宽度 */
.grid-heading{margin:26rpx 4rpx 12rpx}
.timetable-scroll{width:100%;border-radius:16rpx;background:#fff;border:1px solid #d5dee9}
.timetable{box-sizing:border-box;min-width:100%}
.timetable-header{display:flex;height:65px;background:#eaf3fc;position:relative}
.time-header{box-sizing:border-box;width:62px;min-width:62px;padding:20px 4px;font-size:12px;color:#5a708a;border-right:1px solid #c8d6e5}
.grid-day-header{box-sizing:border-box;flex-shrink:0;text-align:center;border-right:1px solid #c8d6e5;padding:10px 4px;font-size:15px;font-weight:700;display:flex;flex-direction:column}
.grid-date{font-size:12px;font-weight:400;color:#667a90;margin-top:5px}
.grid-body{display:flex;position:relative}
.grid-time-axis{box-sizing:border-box;width:62px;min-width:62px;position:relative;border-right:1px solid #c8d6e5}
.hour-label{position:absolute;left:4px;font-size:12px;color:#65788e;transform:translateY(-7px)}
.grid-day-column{position:relative;flex-shrink:0;border-right:1px solid #c8d6e5;box-sizing:border-box}
.hour-rule{position:absolute;left:0;right:0;border-top:1px dotted #ccd7e3;height:0}
.grid-course{position:absolute;box-sizing:border-box;border:1px solid #9eb6cc;border-left:4px solid #2479d8;background:#eef7ff;overflow:hidden;padding:7px 6px;word-break:break-word;white-space:normal}
.grid-course-title{font-size:14px;line-height:1.3;font-weight:800}
.grid-course-line{font-size:12px;line-height:1.4;margin-top:4px}
.grid-strong{font-weight:700}
.grid-conflict{color:#a4520a;background:#fff0d8;font-size:11px;padding:3px;margin-top:5px}
@media (min-width:1000px){.page{max-width:1600px;margin:0 auto}.timetable-scroll{width:100%}}

.grid-address{color:#1262a5;text-decoration:underline}
.drag-ghost{position:fixed;z-index:9999;max-width:190px;pointer-events:none;background:rgba(36,121,216,.88);color:white;padding:12px;border-radius:10px;box-shadow:0 10px 28px rgba(0,0,0,.3);font-weight:bold;transform:rotate(-3deg)}

.page{max-width:1200px;margin:0 auto}

.display-settings{margin:18rpx 0 24rpx;padding:24rpx;background:#fff;border:1px solid #d5dee9;border-radius:16rpx}
.display-times{display:flex;flex-wrap:wrap;gap:24rpx;margin:24rpx 0}
.display-time{flex:1;min-width:120px}
.display-picker{padding:16rpx 22rpx;border:1px solid #c8d6e5;border-radius:10rpx;color:#215b95;font-weight:700;font-size:28rpx}
.display-days{display:flex;flex-wrap:wrap;gap:16rpx}
.display-day{display:flex;align-items:center;min-width:210px;font-size:25rpx;padding:8rpx 0}
.display-day checkbox{margin-right:12rpx}
.display-actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}
.display-actions button{margin:0;background:#216cbd;color:#fff;padding:0 24rpx;font-size:25rpx}
.display-actions button+button{background:#edf3fb;color:#38639b}
.grid-body{overflow:hidden}
/* 最终版布局：独立添加按钮、可折叠设置和法定/自定义假期。 */
