stom{color:#19644d;font-size:12px;font-weight:500;margin-top:3px}.holiday-header{background:#e3f1e9}.suspended-column{background:#f3f9f6}.add-section{margin:24rpx 0}.add-section .add-btn{width:100%;font-size:28rpx;line-height:72rpx;height:72rpx}.conflict-summary{color:#ce6b0a;font-weight:700;font-size:28rpx;margin:28rpx 0 14rpx}.day-conflict{color:#d47410;font-weight:700;font-size:25rpx;margin-bottom:12rpx}.day-detail-group{margin:24rpx 0 40rpx}.day-detail-group .section-hint{margin-bottom:18rpx}.cloud-config{padding:18rpx;border:1px solid #d7e3ee;border-radius:10rpx;margin:20rpx 0}.import-message{font-size:25rpx;white-space:pre-wrap;margin:18rpx 0;color:#35526d}.extracted-text{font-size:22rpx;white-space:pre-wrap;word-break:break-all;line-height:1.6}.export-canvas{position:fixed;left:-3000px;top:0;width:1240px;height:1754px;pointer-events:none}.display-settings{padding:20rpx 24rpx}.grid-course{user-select:none}.preview-row .actions button{margin:0}.backup-buttons{flex-wrap:wrap}.backup-buttons button{min-width:150rpx}.course-head{gap:12rpx}.course-head .time{flex-shrink:0}.type{text-align:right}
@media (min-width:750px){.page{padding:24px 28px 60px;font-size:16px}.headline{font-size:36px}.eyebrow{font-size:13px}.subhead,.mini-desc,.field-label,.section-hint{font-size:14px}.week-heading{font-size:18px}.week-year{font-size:13px}.section-title{font-size:22px}.settings-toggle,.backup-title{font-size:18px}.course-name{font-size:20px}.time{font-size:18px}.info,.note,.display-day,.switch-row,.display-picker{font-size:16px}.day{width:90px}.days{gap:12px}.week-nav{max-width:760px;margin:0 auto}.display-times{max-width:680px}.display-days{gap:10px 24px}.actions .act{font-size:14px}.grid-heading{margin:24px 0 12px}}
