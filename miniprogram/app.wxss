page { background:#f5f7fb; color:#182238; font-size:28rpx; }
button { font-size:26rpx; }
button::after { border:none; }
/* Keep typography usable on phones, rotated tablets and resizable desktop WeChat. */
page{overflow-wrap:break-word}
.page,.help-page{box-sizing:border-box;padding-bottom:calc(40px + env(safe-area-inset-bottom))}
input,textarea{box-sizing:border-box;max-width:100%}
@media(min-width:600px){page{font-size:16px}button{font-size:14px}}
